<?xml version="1.0" encoding="UTF-8"?>
<PROJECT>
  <Image File="$(CMP_SAMPLES)/images/ruby.bmp">
    <Compression Setting="Ruby_bmp_1" Enabled="False">
      <Destination>$(CMP_SAMPLES)/images/Ruby_bmp_1.DDS</Destination>
      <fd>BC7</fd>
    </Compression>
  </Image>
    <Image File="$(CMP_SAMPLES)/images/ruby.png">
        <Compression Setting="Ruby_png_1" Enabled="False">
            <Destination>$(CMP_SAMPLES)/images/Ruby_png_1.DDS</Destination>
            <fd>BC7</fd>
        </Compression>
    </Image>
    <Image File="$(CMP_SAMPLES)/images/ruby.tga">
        <Compression Setting="Ruby_tga_1" Enabled="False">
            <Destination>$(CMP_SAMPLES)/images/Ruby_tga_1.DDS</Destination>
            <fd>BC7</fd>
        </Compression>
    </Image>
    <Image File="$(CMP_SAMPLES)/images/ruby.tif">
        <Compression Setting="Ruby_tif_1" Enabled="False">
            <Destination>$(CMP_SAMPLES)/images/Ruby_tif_1.DDS</Destination>
            <fd>BC7</fd>
        </Compression>
    </Image>
</PROJECT>